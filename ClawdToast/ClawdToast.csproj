<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>clawd-toast</AssemblyName>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWindowsDesktopSdk>false</UseWindowsDesktopSdk>
		<ApplicationIcon>Assets/appicon.ico</ApplicationIcon>
		<WarningsAsErrors>true</WarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineTrace>true</DefineTrace>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />

		<EmbeddedResource Include="Assets/icon16.png" LogicalName="ClawdToast.icon16.png" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants);DEBUG_MOCK_INPUT</DefineConstants>
	</PropertyGroup>
	
	<ItemGroup Condition="$(DefineConstants.Contains('DEBUG_MOCK_INPUT'))">
		<Content Include="Debug\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
